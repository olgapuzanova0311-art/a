# Claude по подписке: токен из `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# (необязательно) ключ API, если хочешь запускать всё одной командой без Claude Code
ANTHROPIC_API_KEY=

# Telegram — api_id/api_hash: https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# строка из scripts/telegram_login.py
TG_SESSION=

# YouGile — см. README, раздел «Ключ YouGile»
YOUGILE_API_KEY=

# Google — JSON ключа сервисного аккаунта одной строкой
GOOGLE_SERVICE_ACCOUNT_JSON=

# Zoom — Server-to-Server OAuth app (marketplace.zoom.us)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
